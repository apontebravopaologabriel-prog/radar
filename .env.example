# SQLite es la base de datos activa. Por defecto usa ~/.local/share/radar/radar.db;
# descomenta para usar otra ruta (acepta también sqlite:///ruta/al/archivo.db).
# RADAR_DB_PATH=/ruta/a/radar.db
RADAR_API_PORT=8100
RADAR_API_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RADAR_COUNTRY=pe
RADAR_DEFAULT_CITY=Lima
RADAR_JOBSPY_SITES=indeed,linkedin
RADAR_COMPUTRABAJO_COMMAND=npx
RADAR_COMPUTRABAJO_ARGS=-y,mcp-computrabajo@latest
RADAR_COMPUTRABAJO_ENABLED=true
